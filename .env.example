# ==============================================================================
# RUPIA V2 - Production Environment Configuration Template
# ==============================================================================

# Database Connection (Neon PostgreSQL / Self-Hosted PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/rupia?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-32-byte-secret-here-with-openssl-rand-base64-32"
AUTH_SECRET="generate-a-strong-32-byte-secret-here-with-openssl-rand-base64-32"
JWT_SECRET="generate-a-strong-32-byte-secret-here-with-openssl-rand-base64-32"

# Google OAuth Credentials (Single Sign-On Provider)
# Setup in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript Origins:
#   - http://localhost:3000
#   - https://rupia.app
# Authorized Redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
#   - https://rupia.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Public App Base URL (HTTPS in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Google Gemini AI API Key for Financial Assistant & OCR
GEMINI_API_KEY=""
